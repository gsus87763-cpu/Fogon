PORT=4000

# --- Desarrollo local: usa estas variables ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=tu_password
DB_NAME=el_fogon

# --- En Railway: NO hace falta llenar las de arriba ---
# Railway inyecta automaticamente MYSQLHOST, MYSQLPORT, MYSQLUSER,
# MYSQLPASSWORD y MYSQLDATABASE cuando enlazas el servicio de MySQL
# (variables tipo "${{MySQL.MYSQLHOST}}"). config/db.js ya las detecta solo.

JWT_SECRET=cambia_esta_clave_por_una_segura
JWT_EXPIRES_IN=8h

# En Railway, apunta esto al dominio publico del servicio frontend, ej:
# CORS_ORIGIN=https://${{frontend.RAILWAY_PUBLIC_DOMAIN}}
CORS_ORIGIN=http://localhost:5173

# URL publica del FRONTEND (para armar el enlace de "restablecer contraseña")
FRONTEND_URL=http://localhost:5173

# --- Login con Google ---
# Client ID de OAuth (Google Cloud Console > Credenciales > ID de cliente OAuth 2.0,
# tipo "Aplicacion web"). Debe coincidir con el que usa el frontend (VITE_GOOGLE_CLIENT_ID).
GOOGLE_CLIENT_ID=

# --- Envio de correo (recuperar contraseña) ---
# Si se dejan vacias, el enlace de recuperacion solo se imprime en la consola
# del backend (util para desarrollo); en produccion hay que configurarlas.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="El Fogón <no-responder@elfogon.com>"

